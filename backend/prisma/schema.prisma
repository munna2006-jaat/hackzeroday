generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

enum OtpPurpose {
  EMAIL_VERIFY
  LOGIN
  PASSWORD_RESET
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum QuestionType {
  TEXT
  FLAG
  MCQ
}

model LearningPath {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String         @default("")
  difficulty  String         @default("beginner")
  coverImage  String?
  status      ContentStatus  @default(DRAFT)
  order       Int            @default(0)
  hours       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  pathModules PathModule[]

  @@index([status, order])
}

model Module {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  description String       @default("")
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  pathModules PathModule[]
  rooms       Room[]

  @@index([order])
}

model PathModule {
  id       String       @id @default(cuid())
  pathId   String
  moduleId String
  order    Int          @default(0)
  path     LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  module   Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([pathId, moduleId])
  @@index([pathId, order])
  @@index([moduleId])
}

model Room {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  description String        @default("")
  difficulty  String        @default("easy")
  duration    String        @default("1h")
  tasksCount  Int           @default(0)
  order       Int           @default(0)
  moduleId    String
  status      ContentStatus @default(DRAFT)
  contentHtml String?       @db.Text
  contentCss  String?       @db.Text
  layoutJson  Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  module      Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions   Question[]

  @@index([moduleId, order])
  @@index([status])
}

model Question {
  id          String       @id @default(cuid())
  roomId      String
  blockId     String
  type        QuestionType
  prompt      String
  answerHash  String?
  optionsJson Json?
  hints       String[]     @default([])
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  room        Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, blockId])
  @@index([roomId, order])
}

model User {
  id             String     @id @default(cuid())
  name           String?
  email          String     @unique
  passwordHash   String
  emailVerified  Boolean    @default(false)
  role           UserRole   @default(STUDENT)
  college        String?
  learningGoal   String?
  points         Int        @default(0)
  solvedCount    Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  otps           EmailOtp[]
  ctfTeams       CtfTeam[]  @relation("TeamCaptain")
}

model EmailOtp {
  id        String     @id @default(cuid())
  userId    String
  email     String
  otpHash   String
  purpose   OtpPurpose @default(EMAIL_VERIFY)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@index([userId, purpose])
}

model CtfTeam {
  id           String   @id @default(cuid())
  eventId      String
  eventTitle   String
  eventType    String
  teamName     String
  college      String?
  inviteCode   String   @unique
  captainId    String
  memberEmails String[] @default([])
  maxMembers   Int      @default(4)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  captain      User     @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([captainId])
  @@index([college])
}
